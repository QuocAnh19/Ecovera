{
  "name": "ecovera-project-root",
  "version": "1.0.0",
  "private": true,
  "description": "Ecovera Workspace Orchestrator",
  "scripts": {
    "install:server": "npm install --prefix Server",
    "install:client": "npm install --prefix Client",
    "install:all": "npm install --prefix Server && npm install --prefix Client",
    "server": "npm start --prefix Server",
    "client": "npm start --prefix Client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue.bold,green.bold\" \"npm run server\" \"npm run client\""
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
